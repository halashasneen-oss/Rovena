<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Rovena" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rovena_accent</item>
        <item name="colorOnPrimary">@color/rovena_on_accent</item>
        <item name="colorSecondary">@color/rovena_accent</item>
        <item name="colorOnSecondary">@color/rovena_on_accent</item>
        <item name="colorSurface">@color/rovena_surface</item>
        <item name="colorOnSurface">@color/rovena_on_surface</item>
        <item name="colorSurfaceVariant">@color/rovena_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/rovena_on_surface_variant</item>
        <item name="colorOutline">@color/rovena_outline</item>
        <item name="android:colorBackground">@color/rovena_background</item>
        <item name="colorError">@color/rovena_status_critical</item>
        <item name="android:statusBarColor">@color/rovena_background</item>
        <item name="android:navigationBarColor">@color/rovena_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialCardViewStyle">@style/Widget.Rovena.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.Rovena.BottomNav</item>
        <item name="floatingActionButtonStyle">@style/Widget.Rovena.Fab</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Rovena.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/rovena_background</item>
        <item name="android:navigationBarColor">@color/rovena_background</item>
    </style>

    <style name="Widget.Rovena.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/rovena_surface</item>
        <item name="strokeColor">@color/rovena_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Rovena.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/rovena_surface</item>
        <item name="itemIconTint">@color/bottom_nav_item_tint</item>
        <item name="itemTextColor">@color/bottom_nav_item_tint</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Rovena.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/rovena_accent</item>
        <item name="tint">@color/rovena_on_accent</item>
    </style>

    <style name="TextAppearance.Rovena.StatNumber" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Rovena.SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Rovena.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Rovena.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/rovena_surface_alt</item>
    </style>

    <style name="ShapeAppearance.Rovena.RoundedCorners" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

</resources>
