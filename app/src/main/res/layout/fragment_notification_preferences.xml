<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView style="@style/TextAppearance.Rovena.SectionHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:text="@string/notification_prefs_section_severity" />
        <include android:id="@+id/rowSeverityCritical" layout="@layout/item_settings_row" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <include android:id="@+id/rowSeverityImportant" layout="@layout/item_settings_row" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <include android:id="@+id/rowSeverityUpcoming" layout="@layout/item_settings_row" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView style="@style/TextAppearance.Rovena.SectionHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:text="@string/notification_prefs_section_categories" />
        <include android:id="@+id/rowCategoryDocuments" layout="@layout/item_settings_row" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <include android:id="@+id/rowCategoryGeneral" layout="@layout/item_settings_row" android:layout_width="match_parent" android:layout_height="wrap_content" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
